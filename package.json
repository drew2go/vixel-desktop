{
  "name": "vixel-admin",
  "productName": "Vixel Admin",
  "version": "1.0.0",
  "description": "Desktop app for the Vixel Agency admin portal",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.vixelagency.admin",
    "productName": "Vixel Admin",
    "artifactName": "Vixel-Admin-${os}-${arch}.${ext}",
    "files": ["main.js", "preload.js", "package.json"],
    "icon": "build/icon.png",
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }], "category": "public.app-category.business", "identity": null },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "perMachine": false },
    "publish": null
  }
}
